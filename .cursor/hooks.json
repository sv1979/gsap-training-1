{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/cursor-before-shell-commit.mjs",
        "matcher": "git\\s+commit",
        "failClosed": true,
        "timeout": 600
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/cursor-after-agent-playwright.mjs",
        "matcher": ".*",
        "timeout": 120
      }
    ]
  }
}